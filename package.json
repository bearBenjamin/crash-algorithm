  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "preview": "serve dist -l 5000",
    "deploy": "gh-pages -d dist",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
