  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "css-loader": "^7.0.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "gh-pages": "^6.1.1",
    "glob": "^11.0.0",
    "gsap": "^3.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "pug-plugin": "^5.0.0",
    "sass": "^1.80.0",
    "sass-loader": "^14.0.0",
    "serve": "^14.2.6",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.40.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
