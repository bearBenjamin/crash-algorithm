          g(class="cup" fill="#fff" stroke="#000")
            path(class="cup-one" stroke-width="4" d="M1240 623c8.23 0 15 6.885 15 15.5s-6.77 15.5-15 15.5-15-6.885-15-15.5 6.77-15.5 15-15.5Z")
            path(class="cup-two" stroke-width="1.5" d="M1201.5 609.5h43v56h-43z")
          g(fill="#fff" stroke="#000" stroke-width="1.5")
            path(class="book-one" d="M417.5 509.5h209v49h-209z")
            path(class="book-two" d="M434.5 559.5h182v35h-182z")
            path(class="book-three" d="M424.5 595.5h192v32h-192z")
            path(class="book-four" d="M417.5 628.5h207v36h-207z")
      </g>
    h1.title.intro__title.intro__title-js
      span.intro__title-mask
        span.intro__title-text Как я грокал код...
    p.subtitle.intro__subtitle.intro__subtitle-js
      span.intro__subtitle-mask
        span.intro__subtitle-text Читательский дневник с визуализацией

    button.button.intro__enter.intro__enter-js(type="button") Войти
block header
  header.home-header
    div(class=`${baseClass}-header__nav`)
      span(class=`${baseClass}-header__menu-item`) Главная
      span(class=`${baseClass}-header__logo`) theBearBenjamin

