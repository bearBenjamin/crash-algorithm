extends layout/_layout

block vars
  - var baseClass = 'home';
  - var mainClass = 'main-page home';
  include data/_book-data.pug

block init
  section.intro.intro-js
    svg.intro__svg.intro__svg-js(
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1760 860"
      fill="none"
      aria-labelledby="cover-title cover-desc"
      role="img"
    )
      title#cover-title Заставка сайта
      desc#cover-desc Скетч-иллюстрация в стиле книги «Грокаем алгоритмы» — кресло читателя, чашка на столе

      g(transform="translate(0 120)")
        path(class="frame" fill="#fff" stroke="#000" stroke-width="1.5" d="M439.5 4.5h875v588h-875z")
        path(class="landscape" fill="#fff" stroke="#000" stroke-width="1.5" d="M1225.11 158.829 1314 336.618V592H508.951c76.6-111.513 241.721-271.45 314.884-337.629l.009-.008.008-.008L984.803 95.402l88.157-50.305z")
        path(class="cloud" fill="#fff" stroke="#000" stroke-linecap="round" stroke-width="1.5" d="M498.5 125s42.5 46.5 61.5 41 113 0 113 0 77.775-28.237 61.5-56.5C724.686 92.457 715 89 688.5 89s-41-25.5-41-25.5-24.5-10-67 0S565 95.5 560 89s-41 0-41 0-20.5 11.5-20.5 20.5z")
        path(class="roof" fill="#fff" stroke="#000" stroke-linecap="round" stroke-width="1.5" d="m1005 214-97-40-1.5-1L985 97l88-50.5L1220.5 157l-57 66.5L1065 190z")
        path(class="ground" fill="#fff" stroke="#000" stroke-width="1.5" d="M394.5 665.5h937v26h-937z")
        g(class="workplace" fill="#fff" stroke="#000")
          path(class="display" stroke-width="3" d="M638 354h510v260H638z")
          rect(class="display-plate" width="519" height="23" x="633.5" y="609.5" stroke-width="1.5" rx="8.5")
          path(class="chair" stroke-width="1.5" d="M806 735V550s0-14.5 27.5-43 98.5-27.5 123 0 23.5 43 23.5 43v185")
        g(class="cup" fill="#fff" stroke="#000")
          path(class="cup-one" stroke-width="4" d="M1240 623c8.23 0 15 6.885 15 15.5s-6.77 15.5-15 15.5-15-6.885-15-15.5 6.77-15.5 15-15.5Z")
          path(class="cup-two" stroke-width="1.5" d="M1201.5 609.5h43v56h-43z")
        g(class="books" fill="#fff" stroke="#000" stroke-width="1.5")
          path(d="M424.5 595.5h192v32h-192zM417.5 509.5h209v49h-209zM417.5 628.5h207v36h-207zM434.5 559.5h182v35h-182z")

    h1.title.intro__title.intro__title-js Как я грокаю код...
    p.subtitle.intro__subtitle.intro__subtitle-js Читательский дневник с визуализацией

    button.button.intro__enter.intro__enter-js(type="button") Войти
block header
  header.home-header
    div(class=`${baseClass}-header__nav`)
      span(class=`${baseClass}-header__menu-item`) Главная
      span(class=`${baseClass}-header__logo`) theBearBenjamin

block content
  include mixin/bookMix
  section.stage
    .stage__wrapper
      h1.title.stage__title Как я грокаю код...
      p.subtitle.stage__subtitle Личный блог о чтении книг по алгоритмам с визуализациями
      +bookList(books)


block scripts
  script(src=require("@scripts/index.ts") defer)
