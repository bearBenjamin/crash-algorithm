include _header-data

-
  var currentPage = 'home'
  var baseClass = 'main-header';

mixin pageHeader(items)
  nav(class=`${baseClass}__nav`)
    a(class=`${baseClass}__logo`)(href="index.html") theBearBenjamin
    ul(class=`${baseClass}__menu`)
      each item in items
        if currentPage === item.id
          li
            span(class=`${baseClass}__menu-link`)= item.text
        else
          li
            a(class=`${baseClass}__menu-link`)(href=`${item.href}`)= item.text



header(class=`${baseClass}`)
  +pageHeader(menuItems)
